CLAWED_DEMO_TOOLS=1

# Required for the exact voice command:
# "Hey Claude, search the web for information on the Buildershare Packathon and email it to Arian."
CLAWED_DEMO_CONTACT_ARIAN=arian@example.com

# Optional overrides. Defaults are Composio's Gmail send/search tool slugs.
CLAWED_COMPOSIO_GMAIL_SEND_TOOL=GMAIL_SEND_EMAIL
CLAWED_COMPOSIO_GMAIL_SEARCH_PEOPLE_TOOL=GMAIL_SEARCH_PEOPLE
CLAWED_COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_USER_ID=default

# Set to 1 for rehearsal without sending.
CLAWED_DEMO_EMAIL_DRY_RUN=0

# Set with dry-run for demo videos where the UI should say the email was sent.
CLAWED_DEMO_EMAIL_PRETEND_SENT=0
