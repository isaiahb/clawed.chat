# ─── MentraOS ────────────────────────────────────────────────────────────────
PACKAGE_NAME=com.isaiah.clawed
MENTRAOS_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_URL=https://your-url.ngrok-free.app
OWNER_CLERK_ID=                   # Clerk user ID that owns the pre-provisioned VM (find in Clerk Dashboard → Users)
COOKIE_SECRET=                    # openssl rand -hex 32

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# BUN_PUBLIC_ prefix exposes to frontend (Bun equivalent of VITE_)
BUN_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_
CLERK_PUBLISHABLE_KEY=pk_
CLERK_SECRET_KEY=sk_
CLERK_FRONTEND_API_URL=           # from Clerk dashboard -> Convex integration

# ─── Database (Convex) ──────────────────────────────────────────────────────
CONVEX_URL=https://your-project.convex.cloud
BUN_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# ─── Browser Use (hackathon host) ───────────────────────────────────────────
BROWSER_USE_API_KEY=bu_

# ─── GCP (VM provisioning) ──────────────────────────────────────────────────
GCP_PROJECT=
GCP_ZONE=us-west1-a
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account-key.json

# ─── Cloudflare (DNS) ───────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ─── Pulumi (infrastructure as code) ────────────────────────────────────────
PULUMI_ACCESS_TOKEN=pul-

# ─── Composio (integrations) ────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG=ac_
COMPOSIO_GCAL_AUTH_CONFIG=ac_
COMPOSIO_GITHUB_AUTH_CONFIG=ac_
COMPOSIO_SLACK_AUTH_CONFIG=ac_
COMPOSIO_NOTION_AUTH_CONFIG=ac_
COMPOSIO_LINEAR_AUTH_CONFIG=ac_
COMPOSIO_GOOGLESHEETS_AUTH_CONFIG=ac_
COMPOSIO_GOOGLEDRIVE_AUTH_CONFIG=ac_
COMPOSIO_GOOGLEDOCS_AUTH_CONFIG=ac_
COMPOSIO_TWITTER_AUTH_CONFIG=ac_
COMPOSIO_DISCORD_AUTH_CONFIG=ac_

# ─── Encryption ─────────────────────────────────────────────────────────────
KEY_ENCRYPTION_SECRET=            # openssl rand -hex 32

# ─── TTS (optional) ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── OpenClaw (per-instance, generated during provisioning) ─────────────────
OPENCLAW_GATEWAY_TOKEN=           # auto-generated per VM

# --- Buildership sponsor stack ---
# Nebius Token Factory (OpenAI-compatible inference + vision)
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.studio.nebius.com/v1
NEBIUS_TEXT_MODEL=openai/gpt-oss-120b
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Tavily real-time search
TAVILY_API_KEY=
# Glasses miniapp vision endpoint auth (optional but recommended)
VISION_API_TOKEN=
# AI-judge endpoint auth (optional — publish in README for Buildership judges)
JUDGE_API_TOKEN=
