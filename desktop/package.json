{
  "name": "clawed-chat-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"CLAWED_DESKTOP_HMR_URL=http://localhost:5174 electrobun dev --watch\"",
    "hmr": "vite --port 5174",
    "build": "vite build && electrobun build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:release": "vite build && electrobun build --env=stable",
    "release:prepare": "./ci/scripts/prepare-release.sh stable",
    "release:publish:r2": "./ci/scripts/publish-r2.sh"
  },
  "dependencies": {
    "electrobun": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
